/* Flight Recorder / warm graphite, sage signal, amber attention. */
$ink: #101312;
$deck: #171C19;
$raised: #202821;
$rail: #303B34;
$fog: #94A399;
$paper: #E5E9DF;
$signal: #9CD6AD;
$hold: #E8BD79;
$fault: #EF9387;
$cold: #A1BFCE;

Screen { background: $ink; color: $paper; }
* { scrollbar-size: 1 1; scrollbar-background: $ink; scrollbar-color: $rail;
    scrollbar-color-hover: $fog; scrollbar-color-active: $cold; }
Static { height: auto; }
Button { min-width: 10; height: 3; border: none; background: $raised; color: $paper; text-style: none; }
Button:hover { background: #354238; }
Button:focus { text-style: bold; background: #34463D; color: $paper; }
Button.-primary { background: $signal; color: $ink; text-style: bold; }
Button.-warning { background: $hold; color: $ink; text-style: bold; }
Button.-error { background: $fault; color: $ink; text-style: bold; }
Button.-primary:hover, Button.-warning:hover, Button.-error:hover { tint: white 10%; }
Button.-primary:focus, Button.-warning:focus, Button.-error:focus { border: tall $paper; }
Input, Select { background: $ink; border: tall $rail; color: $paper; }
Input:focus { border: tall $cold; }
SelectCurrent { background: $ink; border: tall $rail; }
Checkbox { background: transparent; border: none; padding: 0; height: 1; margin-top: 1; }
Checkbox > .toggle--button { color: $signal; background: $raised; }
.muted { color: $fog; }
.eyebrow, .section-label { color: $fog; height: 1; }
.section-label { margin-bottom: 1; }
#shell { height: 100%; }
#resize-guard { display: none; width: 100%; height: 100%; content-align: center middle; padding: 2; }
#masthead { height: 2; padding: 1 1 0 1; background: $deck; }
#wordmark { width: 1fr; height: 1; }
#run-status { width: 25; height: 1; text-align: right; }
#help-hint { width: 12; height: 1; color: $fog; text-align: right; }
#identity { height: 2; padding: 0 1; background: $deck; border-bottom: solid $rail; color: $fog; }
#workspace { height: 1fr; }
#runway { width: 29; padding: 1 1 0 1; border-right: solid $rail; }
#workflow-name { text-style: bold; margin-bottom: 1; }
#run-progress { height: 2; }
OptionList { background: transparent; border: none; padding: 0; }
OptionList > .option-list--option { padding: 0 1; }
OptionList > .option-list--option-highlighted { background: $raised; color: $paper; }
OptionList:focus > .option-list--option-highlighted { background: #2B3D32; color: $paper; border-left: outer $signal; }
#nodes { height: 1fr; }
#nodes > .option-list--option { padding: 0; }
#flow-note { padding: 1 0; border-top: solid $rail; }
#runway-note { color: $fog; padding: 1 0; }
#focus { width: 1fr; }
#view-tabs { height: 3; border-bottom: solid $rail; padding: 0 2; }
.view-tab { height: 2; width: auto; padding: 0 2; background: transparent; color: $fog; }
.view-tab.active-tab { color: $paper; border-bottom: solid $hold; text-style: bold; }
#brief { height: auto; max-height: 9; padding: 1 2; }
#brief-kicker { height: 1; margin-bottom: 1; color: $fog; }
#brief-title { text-style: bold; }
#brief-copy { margin-top: 1; color: $fog; }
#brief.gate-brief { background: #211F19; border-left: wide $hold; padding: 1 2 1 1; }
#overview { height: 1fr; padding: 1 2; }
#overview-content { margin-bottom: 1; }
.secondary-action { width: auto; padding: 0 2; color: $signal; }
#review { height: 1fr; min-height: 6; }
#review-heading { height: 2; padding: 0 2; border-bottom: solid $rail; }
#changes-label { width: 1fr; }
#change-stats { width: auto; }
#evidence { height: 1fr; }
#file-index { width: 27; border-right: solid $rail; }
#file-filter { height: 3; margin: 0 1; }
#files { height: 1fr; padding: 0 1; }
#files > .option-list--option { padding: 0; }
#file-hint { height: 1; padding: 0 1; color: $fog; }
#document { width: 1fr; background: $deck; }
#document-path { height: auto; padding: 0 2; color: $paper; background: $raised; }
#document-tools { height: 2; padding: 0 1; }
.content-tab { min-width: 9; height: 1; padding: 0 1; background: transparent; color: $fog; }
.content-tab.selected-content { background: #354238; color: $paper; }
#file-meta { width: 1fr; text-align: right; padding-right: 1; }
#document-scroll { height: 1fr; padding: 0 2; }
#diff { width: auto; min-width: 100%; }
#rendered { background: transparent; padding: 0; margin: 0; }
MarkdownH1 { border: none; color: $paper; background: transparent; margin: 0 0 1 0; padding: 0; text-style: bold; text-align: left; }
MarkdownH2 { border: none; color: $paper; margin: 1 0 0 0; padding: 0; text-style: bold; }
MarkdownParagraph { margin: 0 0 1 0; }
MarkdownOrderedList, MarkdownUnorderedList { margin: 0; }
#document-note { height: 1; padding: 0 2; color: $fog; }
#context { height: auto; max-height: 3; padding: 1 2 0 2; color: $cold; }
#decision-bar { height: 5; padding: 1 2; }
#decision-label { width: 10; height: 3; content-align: left middle; color: $hold; }
.decision { min-width: 11; width: 1fr; max-width: 19; margin-right: 1; color: $hold; background: #302A20; }
.decision:focus { background: $hold; color: $ink; }
#decision-hint { width: 14; padding-left: 1; color: $fog; }
#output-panel { height: 4; border-top: solid $rail; background: $ink; }
#output-panel.expanded { height: 40%; min-height: 6; }
#output-heading { height: 1; padding: 0 2; }
#output-title { width: 1fr; }
#output-toggle { min-width: 12; width: 12; height: 1; background: transparent; color: $cold; }
#engine { padding: 0 2; background: $ink; color: $fog; height: 1fr; }
#command-rail { height: 2; border-top: solid $rail; background: $deck; padding: 0 1; }
#commands { width: 1fr; height: 1; }
#abort { width: auto; height: 1; padding: 0 1; color: $fog; background: transparent; }
#abort:hover, #abort:focus { color: $fault; }
#preview-rail { height: 1; color: $fog; background: $ink; padding: 0 2; }

/* Compact terminals trade the side rail for a scrollable workflow strip. */
.compact #workspace { layout: vertical; }
.compact #runway { width: 100%; height: 4; layout: horizontal; padding: 0 2; border-right: none; border-bottom: solid $rail; }
.compact #runway .section-label { display: none; }
.compact #workflow-name { width: 22; height: 3; content-align: left middle; }
.compact #run-progress, .compact #flow-note, .compact #runway-note { display: none; }
.compact #nodes { width: 1fr; height: 3; }
.compact #nodes > .option-list--option { padding: 0; }
.compact #focus { width: 100%; height: 1fr; }
.compact #decision-hint { display: none; }
.compact #help-hint { display: none; }
.short #view-tabs { height: 2; }
.short .view-tab { height: 1; border-bottom: none; }
.short .view-tab.active-tab { background: $raised; color: $hold; }
.short #brief { padding: 0 2; max-height: 5; }
.short #brief.gate-brief { padding: 0 2 0 1; }
.short #brief-kicker { margin-bottom: 0; }
.short #brief-copy { margin-top: 0; }
.short #decision-bar { height: 3; padding-top: 0; padding-bottom: 0; }
.short #output-panel { height: 3; }
.short #output-panel.expanded { height: 6; }
.short #context { padding-top: 0; }
.short #flow-note, .short #runway-note { display: none; }
.short #files > .option-list--option { padding: 0; }
.compact #brief { padding: 0 2; max-height: 5; }
.compact #brief.gate-brief { padding: 0 2 0 1; }
.compact #brief-kicker { margin-bottom: 0; }
.compact #brief-copy { margin-top: 0; }
.compact #decision-bar { height: 3; padding: 0 2; }
.compact #output-panel { height: 3; }
.compact #output-panel.expanded { height: 6; }
.not-applicable { display: none; }

/* Launch is an editorial opening, not a dashboard of cards. */
#launch-content { height: 1fr; padding: 2 5; }
#launch-eyebrow { color: $hold; margin-bottom: 1; }
#launch-logo { height: 5; color: $paper; margin-bottom: 1; text-wrap: nowrap; }
#launch-intro { color: $fog; margin-bottom: 2; }
#launch-columns { height: auto; }
#catalog { width: 35; height: auto; padding-right: 3; }
#workflows { height: 13; }
#workflows > .option-list--option { padding: 0 1; }
#catalog-note { margin-top: 1; }
#launch-detail { width: 1fr; height: auto; border-left: solid $rail; padding: 0 3; }
#detail-name { color: $paper; text-style: bold; margin-bottom: 1; }
#detail-description { color: $fog; margin-bottom: 1; }
#detail-flow { color: $cold; margin: 1 0 2 0; }
#launch-state { margin: 1 0; }
#configure, #start { width: auto; padding: 0 3; }
#start-note { color: $fog; margin-top: 1; }
#config-form { height: auto; }
.field-label { color: $fog; margin-bottom: 0; }
#profile { width: 100%; }
#validation { color: $fault; }
#launch-commands { height: 2; border-top: solid $rail; background: $deck; padding: 0 2; color: $fog; }
.configuring #launch-logo, .configuring #launch-intro { display: none; }
.short #launch-content { padding: 1 3; }
.short #launch-intro { margin-bottom: 1; }
.compact #catalog { width: 30; padding-right: 2; }
.compact #launch-detail { padding: 0 2; }

/* Confirmation deliberately has no default affirmative focus. */
ConfirmScreen, HelpScreen { align: center middle; background: $ink 80%; }
#confirm-sheet, #help-sheet { width: 64; height: auto; max-height: 95%; padding: 1 3; background: $deck; border-top: heavy $hold; border-bottom: solid $rail; }
#confirm-sheet.danger { border-top: heavy $fault; }
#confirm-heading { text-style: bold; margin: 1 0; }
#confirm-effect { margin-bottom: 1; }
.sheet-actions { height: 3; margin: 2 0 1 0; }
.sheet-actions Button { width: auto; padding: 0 2; margin-right: 2; }
#help-sheet { width: 70; overflow-y: auto; }
#close-help { margin-top: 1; width: auto; padding: 0 2; }
