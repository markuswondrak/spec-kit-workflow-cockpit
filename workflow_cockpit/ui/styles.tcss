/* Flight Recorder / warm graphite, sage signal, amber attention.
 * The ten semantic tokens ($ink..$cold) and the accent tokens ($selection,
 * $focus, $hover) are supplied by the active styling template's Textual theme. */
Screen { background: $ink; color: $paper; }
* { scrollbar-size: 1 1; scrollbar-background: $ink; scrollbar-color: $rail;
    scrollbar-color-hover: $fog; scrollbar-color-active: $cold; }
Static { height: auto; }
Button { min-width: 10; height: 3; border: none; background: $raised; color: $paper; text-style: none; }
Button:hover { background: $hover; }
Button:focus { text-style: bold; background: $focus; color: $paper; }
Button.-primary { background: $signal; color: $ink; text-style: bold; }
Button.-warning { background: $hold; color: $ink; text-style: bold; }
Button.-error { background: $fault; color: $ink; text-style: bold; }
Input, Select { background: $ink; border: tall $rail; color: $paper; }
Input:focus { border: tall $cold; }
SelectCurrent { background: $ink; border: tall $rail; }
Checkbox { background: transparent; border: none; padding: 0; height: 1; margin-top: 1; }
Checkbox > .toggle--button { color: $signal; background: $raised; }
.muted { color: $fog; }
.eyebrow, .section-label { color: $fog; height: 1; }
.section-label { margin-bottom: 1; }
.field-label { color: $fog; height: auto; margin-top: 1; margin-bottom: 1; }

#shell { height: 100%; }
#resize-guard { display: none; width: 100%; height: 100%; content-align: center middle; padding: 2; }

#masthead { height: 2; padding: 1 1 0 1; background: $deck; }
#wordmark { width: 1fr; height: 1; }
#style-field { width: 32; height: 1; color: $fog; text-align: right; padding-right: 1; }
#run-status { width: 30; height: 1; text-align: right; }
#help-hint { width: 12; height: 1; color: $fog; text-align: right; }
#identity { height: 2; padding: 0 1; background: $deck; border-bottom: solid $rail; color: $fog; }
#style-note { height: 1; padding: 0 2; background: $deck; color: $fog; }

/* Launch */
#launch-content { height: 1fr; padding: 2 7; align-horizontal: center; }
#launch-eyebrow, #launch-logo, #launch-intro, #workflow-picker { width: 100%; max-width: 90; }
#launch-eyebrow { color: $hold; margin-bottom: 1; }
#launch-logo { height: 5; color: $paper; margin-bottom: 1; text-wrap: nowrap; }
#launch-intro { color: $fog; margin-bottom: 2; }
#workflow-picker { height: auto; }
#picker-help { color: $fog; margin-bottom: 1; }
#workflows { width: 100%; height: auto; min-height: 5; }
#workflows > .option-list--option { padding: 0 2; }
#workflows > .option-list--option-highlighted { border-left: wide $signal; padding-left: 1; }
#catalog-note { color: $fog; margin-top: 1; padding-left: 2; }
#existing-runs-section { width: 100%; max-width: 90; height: auto; margin-top: 2; }
#existing-runs { width: 100%; height: auto; max-height: 8; background: $deck;
    border-left: solid $cold; color: $fog; }
#existing-runs > .option-list--option { padding: 0 1; color: $fog; }
#existing-runs > .option-list--option-highlighted { background: $raised; color: $paper; }
#existing-runs:focus > .option-list--option-highlighted { background: $selection; color: $paper; }
#existing-runs-note { color: $fog; margin-top: 1; padding-left: 2; }
.configuring #existing-runs-section { display: none; }
#workflow-empty { display: none; width: 100%; max-width: 90; min-height: 10; margin-top: 1; padding: 2 3;
    background: $deck; border-left: wide $hold; content-align: left middle; }
#launch-detail { display: none; width: 100%; max-width: 90; height: auto; }
#detail-name { color: $paper; text-style: bold; margin-bottom: 1; }
#detail-description { color: $fog; margin-bottom: 1; }
#detail-flow { color: $cold; margin: 1 0 2 0; }
#launch-state { margin: 1 0; }
#start { width: auto; padding: 0 3; }
#config-form { height: auto; }
#validation { color: $fault; min-height: 1; }
#start-note { color: $fog; margin-top: 1; }
#launch-commands { height: 2; border-top: solid $rail; background: $deck; padding: 0 2; color: $fog; }
.configuring #launch-logo, .configuring #launch-intro, .configuring #launch-eyebrow { display: none; }
.short #launch-content { padding: 1 4; }
.compact #launch-content { padding-left: 3; padding-right: 3; }

/* Preflight */
#preflight-content { height: 1fr; padding: 2 5; }
#preflight-list { margin-bottom: 2; }
#preflight-repair { color: $fog; }

/* Cockpit */
#header { height: 4; }
#workspace { height: 1fr; }
#runway { width: 36; padding: 1 1 0 1; border-right: solid $rail; }
#workflow-name { text-style: bold; margin-bottom: 1; }
#run-progress { height: 1; margin-bottom: 1; }
#runway-graph { height: 1fr; }
#runway-graph > .option-list--option-highlighted { background: transparent; }
OptionList { background: transparent; border: none; padding: 0; }
OptionList > .option-list--option { padding: 0 1; }
OptionList > .option-list--option-highlighted { background: $raised; color: $paper; }
OptionList:focus > .option-list--option-highlighted { background: $selection; color: $paper; }
#focus { width: 1fr; }
#view-tabs { height: 2; border-bottom: solid $rail; padding: 0 2; }
#view-label { width: 1fr; height: 1; }
#review-status { width: auto; height: 1; color: $fog; text-align: right; }
#overview { height: 1fr; padding: 1 2; }
#overview.compact-summary { height: 4; padding: 0 2; }
#overview-content { margin-bottom: 1; }
#overview.gate-summary { height: auto; max-height: 9; }
#review-panel { display: none; height: 1fr; }
#review-index { width: 42; height: 1fr; border-right: solid $rail; }
#review-filter { border: none; background: $ink; height: 1; padding: 0 1; }
#changed-files { width: 100%; height: 1fr; padding: 0 1; }
#review-scroll { width: 1fr; height: 1fr; }
#review-document { padding: 1 2; }
#review-markdown { padding: 1 2; height: auto; }
#review-markdown .link { color: $cold; text-style: underline; }
#review-markdown MarkdownTable { border: solid $rail; }
#decide-bar { display: none; height: auto; max-height: 10; border-top: solid $rail; padding: 0 2; }
#decide-label { width: 9; height: 1; color: $fog; }
#gate-options { width: 1fr; height: auto; max-height: 9; }
#gate-options > .option-list--option { padding: 0 1; }
#gate-options.disabled > .option-list--option { color: $fog; }
#gate-options.disabled > .option-list--option-highlighted { background: transparent; color: $fog; }
#gate-options.disabled:focus > .option-list--option-highlighted { background: transparent; color: $fog; }
#decide-hint { width: auto; height: 1; color: $fog; text-align: right; padding-right: 1; }
.compact #review-index { width: 28; }
#output { height: 5; border-top: solid $rail; background: $ink; }
#output.expanded { height: 45%; min-height: 6; }
#output.full-canvas { height: 1fr; }
#output-heading { height: 1; padding: 0 2; }
#output-title { width: 1fr; }
#activity { width: auto; height: 1; padding: 0 1; color: $signal; }
#output-hint { width: auto; color: $fog; }
#engine { padding: 0 2; background: $ink; color: $fog; height: 1fr; }
#command-rail { height: 2; border-top: solid $rail; background: $deck; padding: 0 1; }
#commands { width: 1fr; height: 1; }
#abort { width: auto; height: 1; padding: 0 1; color: $fog; background: transparent; }
#abort:hover, #abort:focus { color: $fault; }

/* Compact and short terminals */
.compact #workspace { layout: vertical; }
.compact #runway { width: 100%; height: 4; layout: horizontal; padding: 0 2; border-right: none; border-bottom: solid $rail; }
.compact #runway .section-label { display: none; }
.compact #workflow-name { width: 22; height: 3; content-align: left middle; }
.compact #run-progress { display: none; }
.compact #runway-graph { width: 1fr; height: 3; }
.short #view-tabs { height: 1; }
.short #output { height: 3; }
.short #output.expanded { height: 6; }
.compact #output { height: 3; }
.compact #output.expanded { height: 6; }

/* Confirmation, abort, and help sheets */
ConfirmScreen, AbortingScreen, HelpScreen { align: center middle; background: $ink 80%; }
#confirm-sheet, #abort-sheet, #help-sheet { width: 64; height: auto; max-height: 95%; padding: 1 3; background: $deck; border-top: heavy $hold; border-bottom: solid $rail; }
#abort-sheet { border-top: heavy $fault; }
#abort-heading { text-style: bold; margin: 1 0; }
#abort-activity { width: auto; height: 1; color: $fault; }
#confirm-sheet.danger { border-top: heavy $fault; }
#confirm-heading { text-style: bold; margin: 1 0; }
#confirm-effect { margin-bottom: 1; }
.sheet-actions { height: 3; margin: 2 0 1 0; }
.sheet-actions Button { width: auto; padding: 0 2; margin-right: 2; }
#help-sheet { width: 74; overflow-y: auto; }
#close-help { margin-top: 1; width: auto; padding: 0 2; }
