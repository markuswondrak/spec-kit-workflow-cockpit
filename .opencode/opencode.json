{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "spec-kit-agent",
  "agent": {
    "spec-kit-agent": {
      "description": "Headless Spec Kit workflow agent with pre-approved in-project permissions",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "temperature": 0.1,
      "permission": {
        "*": "allow",
        "question": "deny",
        "doom_loop": "allow",
        "external_directory": {
          "*": "deny"
        }
      }
    }
  }
}
